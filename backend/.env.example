# Copy this to .env and fill in real values.

# Postgres connection string.
DATABASE_URL=postgresql://newsrec:newsrec@localhost:5432/newsrec

# Secret used to sign JWTs — generate a long random string for real deployments.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Live news --------------------------------------------------------------
# BBC, Al Jazeera and the Zambian outlets (Lusaka Times, Zambia Daily Mail,
# Times of Zambia, Zambia Monitor, ZNBC) are read from their free public RSS
# feeds — no key needed.
# CNN no longer publishes working RSS feeds, so CNN headlines come from
# NewsAPI.org. Get a free key at https://newsapi.org/register and paste it
# here. Leave blank to run without CNN (everything else still works).
NEWSAPI_KEY=

# Refresh news automatically while `python run.py` is running.
NEWS_AUTO_REFRESH=true
NEWS_REFRESH_MINUTES=30
# Ignore feed items older than this.
NEWS_MAX_AGE_DAYS=7
# Look up a thumbnail image for up to N new articles per source per refresh
# (for feeds that don't include images).
NEWS_IMAGE_LOOKUPS_PER_SOURCE=8
# Comma-separated source keys to switch off (see `flask list-sources`).
NEWS_DISABLED_SOURCES=

# --- Smart summaries ---------------------------------------------------------
# Readers get an in-app summary of each story (several outlets' reporting
# combined into one) instead of only a link to the publisher.
# Without a key, a built-in offline summariser picks the key sentences.
# With a free Google Gemini key (https://aistudio.google.com/apikey), the
# summaries are rewritten as clear prose with key points.
GEMINI_API_KEY=
# Model to use; if it isn't available on your key, newer/lighter models are tried automatically.
GEMINI_MODEL=gemini-3.5-flash
# Pre-write summaries for the top N trending stories after each refresh (0 = off).
SUMMARY_PREWARM_TRENDING=5

# --- AI People Profiles --------------------------------------------------------
# Names of people in articles become clickable profiles. Facts come from
# Wikidata/Wikipedia and the latest news (no keys needed); with GEMINI_API_KEY
# set, the profile text is written by Gemini from those sources only.
# After each news refresh, scan new articles and update profiles.
PEOPLE_AUTO_UPDATE=true

# Comma-separated categories to ingest / recommend across.
# (These are the RL model's arms — changing them requires retraining.)
NEWS_CATEGORIES=politics,economics,technology,global-affairs,sports,health

# Where the trained bandit policy is stored/loaded from.
RL_MODEL_PATH=rl/artifacts/bandit_policy.zip

# Frontend origins allowed to call the API ('*' = any; fine for local use).
CORS_ORIGINS=*

FLASK_ENV=development
